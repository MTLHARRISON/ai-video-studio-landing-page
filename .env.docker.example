# Copy to .env.docker and fill in, then:
#   docker compose --env-file .env.docker up -d --build

# --- Postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- JWT / API keys ---------------------------------------------------------
# JWT_SECRET: any random string, 32+ chars  ->  openssl rand -hex 32
# The anon + service_role keys must be JWTs SIGNED WITH THE SAME JWT_SECRET.
# Generate them at https://supabase.com/docs/guides/self-hosting#api-keys
# (payloads: {"role":"anon","iss":"supabase"} / {"role":"service_role","iss":"supabase"})
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Realtime needs its own 64-char base secret -> openssl rand -hex 32
REALTIME_SECRET_KEY_BASE=

# --- URLs / ports -----------------------------------------------------------
APP_PORT=3000
KONG_HTTP_PORT=8000
STUDIO_PORT=54323
# URL the browser uses to reach the Supabase gateway (Kong).
# On a server, set this to e.g. https://api.yourdomain.com
PUBLIC_SUPABASE_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**

# --- Spotify (edge functions) ----------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
